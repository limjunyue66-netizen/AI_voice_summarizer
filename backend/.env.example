# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Agnes AI API Key
AGNES_API_KEY=your_agnes_api_key_here

# Optional: Agnes AI Base URL (Default: https://apihub.agnes-ai.com/v1)
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Optional: Agnes AI Model (Default: agnes-2.5-flash)
AGNES_MODEL=agnes-2.5-flash

# Optional: Gemini Model (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Maximum upload size in MB (Default: 250)
MAX_UPLOAD_SIZE_MB=250

# Optional: Custom FFmpeg executable path if not found in PATH or imageio-ffmpeg
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

